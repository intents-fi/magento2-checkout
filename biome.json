{
    "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
    "root": false,
    "files": {
        "includes": ["**", "!dev/phpunit/vendor", "!dev/magento/src"]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "overrides": [
        {
            "includes": ["view/**/*.html"],
            "linter": {
                "rules": {
                    "a11y": {
                        "noLabelWithoutControl": "off",
                        "useAnchorContent": "off",
                        "useValidAnchor": "off"
                    }
                }
            }
        }
    ]
}
