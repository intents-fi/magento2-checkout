{
    "name": "intentsfi/module-checkout-dev",
    "description": "Tooling for the pure-logic PHPUnit suite of IntentsFi_Checkout. Never shipped.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "IntentsFi\\Checkout\\": "../../"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit -c ../../phpunit.xml.dist"
    }
}
