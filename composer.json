{
    "name": "intents/module-checkout",
    "description": "Intents Checkout for Magento Open Source: customers pay with the crypto they hold, you receive one stablecoin at your own address. Non-custodial.",
    "type": "magento2-module",
    "version": "1.0.3",
    "license": "MIT",
    "homepage": "https://intents.fi/docs/checkout/magento",
    "support": {
        "email": "support@intents.fi",
        "docs": "https://intents.fi/docs/checkout/magento"
    },
    "keywords": ["magento2", "payment", "crypto", "stablecoin", "usdc", "usdt"],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "ext-json": "*",
        "magento/framework": "^103.0.7",
        "magento/module-admin-notification": "^100.4.6",
        "magento/module-backend": "^102.0.7",
        "magento/module-checkout": "^100.4.7",
        "magento/module-config": "^101.2.7",
        "magento/module-directory": "^100.4.7",
        "magento/module-payment": "^100.4.7",
        "magento/module-quote": "^101.2.7",
        "magento/module-sales": "^103.0.7",
        "magento/module-store": "^101.1.7"
    },
    "replace": {
        "intentsfi/module-checkout": "self.version"
    },
    "autoload": {
        "files": ["registration.php"],
        "psr-4": {
            "IntentsFi\\Checkout\\": ""
        }
    }
}
